# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Node / JavaScript
/node_modules/
/.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build outputs
/.next/
/out/
/build/
/dist/

# Production / general build
/coverage/
/public/.cache/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Environment files
# Keep example files but ignore real secrets
.env
.env.local
.env.*.local
.env*

# Vercel
.vercel/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Editors & IDEs
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS files
.DS_Store
Thumbs.db

# Certificates / keys
*.pem

# Python
__pycache__/
*.py[cod]
*$py.class
.python-version
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.mypy_cache/
.pyre/

# Packaging / distribution
dist/
build/
*.egg-info/

# Coverage reports
htmlcov/
coverage/

# Misc
.cache/
.next/cache/

# Ignore local secrets and state
.local

